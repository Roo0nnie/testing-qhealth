INSIGHT_GENIE_BASE_URL=https://api.insightgenie.ai
INSIGHT_GENIE_API_KEY=your-insight-genie-api-key-here
INSIGHT_GENIE_API_SECRET=your-insight-genie-api-secret-here
GALE_API_BASE_URL=https://your-gale-api-domain.com
GALE_API_KEY=your-gale-api-key-here
GALE_SCAN_SOURCE_SYSTEM_NAME=QHealth System
GALE_SCAN_SOURCE_PUBLISHER=QHealth
GALE_API_ENABLED=true

# webpack-dev-server (local `pnpm run dev` only). Ignored for production build; do not add these to Vercel.
WEBPACK_DEV_SERVER_PORT=8001
WEBPACK_DEV_SERVER_HOST=localhost
WEBPACK_DEV_SERVER_HTTPS=true
WEBPACK_DEV_SERVER_USE_LOCAL_IP=false
WEBPACK_DEV_SERVER_DISABLE_HOST_CHECK=true

# Public hostname / reverse proxy: set ONE of the following (see README).
# WEBPACK_DEV_SERVER_PUBLIC_URL=wss://qhealth-webbased.quanbyit.com/ws
# WDS_SOCKET_HOST=qhealth-webbased.quanbyit.com
# WDS_SOCKET_PORT=443
# WDS_SOCKET_PATH=/ws
# WDS_SOCKET_PROTOCOL=wss

# When WEBPACK_DEV_SERVER_DISABLE_HOST_CHECK is false, optional comma-separated hosts:
# WEBPACK_DEV_SERVER_ALLOWED_HOSTS=qhealth-webbased.quanbyit.com

# WEBPACK_DEV_SERVER_DISABLE_HMR=true
